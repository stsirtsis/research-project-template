.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# Ignore the outputs (keep the .placeholder files for GitHub)
outputs/**
!outputs/**/
!outputs/**/.placeholder

# Ignore the figures
figures/*pdf
figures/*png

# Ignore the backups
backups*

# Ignore the data (keep data/original/.placeholder for GitHub)
data/original/*
!data/original/.placeholder
data/**/*json
data/**/*csv

# Ignore downloaded models (keep the .placeholder)
models/hf_cache/*
!models/hf_cache/.placeholder

# Ignore vscode things
**.DS_Store
.vscode/**

